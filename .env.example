# .env.example
# Copy to .env and fill in values
# NEVER commit .env to version control

# API
FLEET_API_KEY=dev-only-key   # CHANGE IN PRODUCTION

# Database
POSTGRES_PASSWORD=fleet_dev_password
DATABASE_URL=postgresql://fleet:${POSTGRES_PASSWORD}@localhost:5432/fleet

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=fleet-artifacts

# ML
MLFLOW_TRACKING_URI=http://localhost:5000

# Monitoring
GRAFANA_PASSWORD=admin_change_me

# ROS 2 (Phase 1 — Gazebo container)
ROS_DOMAIN_ID=42
# Simulation mode: headless (default, in-process deterministic sim) or
# gazebo (attach the backend ROS bridge to the Gazebo container)
SIM_MODE=headless

# Konnex (STUB — do not fill until SDK is verified)
KONNEX_NETWORK_URL=
KONNEX_API_KEY=

# ─── Agentic Payment Layer (Arc + Circle USDC) — docs/payments.md ───────────
# Provider mode: mock (default, in-process USDC/Arc simulation labeled
# MOCK/DEMO) | real (Circle Wallets REST + Arc JSON-RPC — implemented,
# requires credentials below) | disabled (payment API refuses to start)
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=USDC
PAYMENT_FLEET_ID=FLEET-017
PAYMENT_DAILY_BUDGET_USDC=500
PAYMENT_MAX_TX_USDC=250
PAYMENT_WALLET_ID=fleet-agent-wallet-001
PAYMENT_WALLET_INITIAL_BALANCE_USDC=1000
# Real-mode settlement target on Arc (0x + 40 hex) — REQUIRED for
# PAYMENT_PROVIDER=real. The provider catalog addresses are deterministic
# placeholders, so a real deployment must name the receiving wallet.
PAYMENT_DESTINATION_ADDRESS=

# Live fleet -> payment bridge: real mission telemetry (low battery / failed
# robot) becomes policy-gated agent payments shown in the FleetPay panel.
PAYMENT_LIVE_BRIDGE=true
PAYMENT_LOW_BATTERY_THRESHOLD=0.20
PAYMENT_BRIDGE_INTERVAL_S=2.0

# Circle Wallets (required for PAYMENT_PROVIDER=real) — leave empty in demo
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_TOKEN_ID=
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_CONFIG_ID=

# Arc settlement (required for PAYMENT_PROVIDER=real) — leave empty in demo
# Chain ids: 5042 (mainnet) / 5042002 (testnet); explorer derived if empty.
# Mainnet RPC: https://rpc.mainnet.arc.io   Testnet RPC: https://rpc.testnet.arc.io
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_CONTRACT_ADDRESS=
ARC_EXPLORER_URL=

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/fleet
